{
  "name": "PlayerUpgrade",
  "type": "object",
  "properties": {
    "upgrade_id": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User ID"
    }
  },
  "required": [
    "upgrade_id",
    "user_id"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    }
  }
}